# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings -> API Keys). .env.local is git-ignored.
# Both values are public by design; access is controlled by Row Level Security.
# Never put the secret or service-role key in any NEXT_PUBLIC_ variable.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Older projects without publishable keys can use the anon key instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public base URL of the site. Used for auth email links, canonical URLs,
# social previews and the sitemap. Required in production.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Search engines are told not to index the site unless this is "true".
# Leave it unset for local, staging and while the catalogue is sample data.
# NEXT_PUBLIC_ALLOW_INDEXING=true
